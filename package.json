{
  "name": "deepfake-identity-firewall-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "server": "npm --prefix server start",
    "client": "npm --prefix client dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
